{
  "compilerOptions": {
    "target": "es2022",
    "module": "commonjs",
    "checkJs": true,
    "noEmit": true,
    "skipLibCheck": true,
    "maxNodeModuleJsDepth": 0,
    "strict": false,
    "types": [ "node", "mocha" ]
  },
  "include": [ "*.js", "lib/**/*.js", "test/**/*.js", "stress/**/*.js" ],
  "exclude": [ "node_modules" ]
}
